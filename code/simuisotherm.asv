R = 8.314E-3;

c = mean([C]);
% 

datareal = cleandatami(b0t550);

t0 = datareal(1,2);
tf = datareal(end,2);
T0 = datareal(1,1);
Tf = datareal(end,1);
b = 20;

tp = (Tf-T0)/b;
%         
% dadt = @(t,aT)    [ A_1*exp(-E{1}/R/aT(5))*real(aT(1)^nmp_1(1)*(1-aT(1))^nmp_1(2)) ;          %1
